# Copy to .env and adjust. Every value except SECRET_KEY has a sensible default.

# Required. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# External services (no API keys needed)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim policy requires an identifying User-Agent: put your contact here.
NOMINATIM_USER_AGENT=fuel-route-planner/0.1 (you@example.com)
HTTP_TIMEOUT_SECONDS=10

# Vehicle and Corridor
CORRIDOR_MILES=8
RANGE_MILES=500
MPG=10
MIN_RESERVE_MILES=0

# Cache: in-memory by default; e.g. redis://localhost:6379/0 to share across workers
CACHE_URL=locmemcache://
PLAN_CACHE_SECONDS=86400
GEOCODE_CACHE_SECONDS=2592000

# Logging: one line per request with its external calls and per-stage timings
LOG_LEVEL=INFO
