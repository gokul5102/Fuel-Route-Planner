{
  "info": {
    "_postman_id": "6f1c2d3e-9a4b-4c5d-8e7f-0a1b2c3d4e5f",
    "name": "Fuel Route Planner",
    "description": "GET /api/route/?start=…&finish=… returns the cheapest Fuel stops (500-mile Range, 10 MPG, empty tank at start), the total fuel cost and a map. Set `baseUrl` if the server is not on http://localhost:8000. Run the folder \"1. Plan a trip\" in order: the second and third requests expect the cache filled by the first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"X-External-Calls header is present\", () => {",
          "    pm.response.to.have.header(\"X-External-Calls\");",
          "});",
          "pm.test(\"X-Response-Time-Ms header is present\", () => {",
          "    pm.response.to.have.header(\"X-Response-Time-Ms\");",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Plan a trip",
      "item": [
        {
          "name": "Cross-country (Chicago to Los Angeles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has Fuel stops whose costs add up to the total\", () => {",
                  "    const plan = pm.response.json();",
                  "    pm.expect(plan.fuel_stops.length).to.be.above(0);",
                  "    const sum = plan.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
                  "    pm.expect(sum).to.be.closeTo(plan.total_fuel_cost, 0.001);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/route/?start=Chicago, IL&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "Chicago, IL to Los Angeles, CA. Uncached, it makes exactly one routing call (X-External-Calls: 1); both places resolve locally from the Census places file."
          },
          "response": []
        },
        {
          "name": "Cross-country again (cache hit, 0 calls)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has Fuel stops whose costs add up to the total\", () => {",
                  "    const plan = pm.response.json();",
                  "    pm.expect(plan.fuel_stops.length).to.be.above(0);",
                  "    const sum = plan.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
                  "    pm.expect(sum).to.be.closeTo(plan.total_fuel_cost, 0.001);",
                  "});",
                  "pm.test(\"made 0 external call(s)\", () => {",
                  "    pm.expect(pm.response.headers.get(\"X-External-Calls\")).to.eql(\"0\");",
                  "});",
                  "pm.test(\"served from the cache\", () => {",
                  "    pm.expect(pm.response.json().meta.cache).to.eql(\"hit\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/route/?start=Chicago, IL&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "The same trip again: the whole plan comes from the cache, with no external calls. Run it after the request above."
          },
          "response": []
        },
        {
          "name": "Map page (Cross-country)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"made 0 external call(s)\", () => {",
                  "    pm.expect(pm.response.headers.get(\"X-External-Calls\")).to.eql(\"0\");",
                  "});",
                  "pm.test(\"is an HTML page with a Leaflet map\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
                  "    pm.expect(pm.response.text()).to.include(\"leaflet\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/route/map/?start=Chicago, IL&finish=Los Angeles, CA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "map",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Los Angeles, CA"
                }
              ]
            },
            "description": "The `map.url` from the response: the same plan on a Leaflet map. It reuses the cached plan, so after the requests above it makes no external calls. Open it in a browser to see the map."
          },
          "response": []
        },
